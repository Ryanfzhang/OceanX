flowchart TB
    U["用户问题与海洋数据"] --> UI["OceanX Desktop"]
    UI --> C["Coordinator<br/>理解问题 · 编排任务 · 综合证据"]
    C -->|"开放研究问题"| T

    subgraph R["研究探索闭环 · 仅 Coordinator 维护"]
        T["研究树<br/>问题根节点 → 同层候选 → 子问题"]
        T --> D["Coordinator 观察 · 构思 · 选择"]
        D -->|"扩展：提出子假设"| T
        F["Coordinator 评估<br/>证据反馈 · 信息增益 · 分支状态"] --> T
    end

    D -->|"检验：一个研究子问题"| E
    C -->|"普通任务：直接委派"| E

    subgraph X["Expert 执行层 · 不接收研究树"]
        E["DeepAgents 原生同步 task<br/>独立上下文 · 同根工作区与 Python 内核复用"]
        E --> A["文献检索 · 数据检查 · 分析计算"]
        A --> W["report.md<br/>短 Summary · 自由正文"]
        A --> N["ScientificFigure.save(.nc)<br/>数据 · Panel · Layer · 单位"]
    end

    W -->|"研究任务反馈"| F
    W -->|"交付结果"| C
    N -->|"确定性预览与交互视图"| STORE
    A <--> DATA["任务工作区<br/>数据 · 代码 · 文件"]
    W --> STORE["任务目录<br/>report.md · 代码 · .nc · 预览"]
    T -.-> STORE

    D -->|"主分支走通 / 全部不可继续 / 暂停"| C
    C --> OUT["最终回答<br/>研究树文本 · 结论与引用 · 图表"]
    STORE -.-> OUT
    OUT --> UI

    SK["只读方法 Skills<br/>按角色暴露 · 按需加载"] -.-> E

    classDef coord fill:#17334D,color:#fff,stroke:#17334D;
    classDef tree fill:#E0F2EF,color:#17334D,stroke:#309889;
    classDef expert fill:#E8EFFA,color:#17334D,stroke:#6C8CB5;
    classDef memory fill:#F5EFE4,color:#554431,stroke:#BD9D65;
    class C,D,F coord;
    class T tree;
    class E,A,W,N expert;
    class DATA,STORE,SK memory;
