# Copy to benchmarking/.env on the server, then fill this ONE key.
# .env is ignored by Git. Do not source it or put it in a dataset/result folder.
DEEPSEEK_API_KEY=

# One model for OceanX Coordinator/Experts, meta/labels, Claude Code and Finch.
BENCH_MODEL=deepseek-flash
BENCH_MAX_TOKENS=32768

# These are two API formats of the SAME DeepSeek service and share the key above.
BENCH_OCEANX_API=openai
BENCH_OPENAI_BASE_URL=https://api.deepseek.com
BENCH_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Data and results are separate. Relative paths resolve from the OceanX checkout.
BENCH_DATA_ROOT=/import/home3/share/mafzhang
BENCH_OUTPUT_ROOT=/home/mafzhang/oceanx-bench
BENCH_EXPERIMENT=methods-public-r1

# test: Q01-Q30; evolution: E01-E24. Optional evolution set: A or B.
BENCH_SUITE=test
BENCH_EVOLUTION_SET=
# available = freeze all data-complete questions; all = require the full suite.
# Or an explicit comma/space-separated list, e.g. Q07,Q08,Q09 or E01,E10.
BENCH_TASKS=available
BENCH_TIMEOUT_SECONDS=10800
BENCH_LITERATURE_MODE=search_only
# false: new method output only; true: resume existing outputs, start unstarted methods.
# Completed cases are skipped; unfinished cases get a new attempt, not a live resume.
# Prespecify retries for scored runs. Change EXPERIMENT for a new repeat/config.
BENCH_RESUME=false

# OceanX always defaults to v2-nested. Optional frozen lesson/tool library.
BENCH_OCEANX_ARM=OceanX
BENCH_OCEANX_LIBRARY=
BENCH_OCEANX_MAX_PARALLEL_EXPERTS=2

# Selecting Claude explicitly approves these tools, including host Bash (not sandboxed).
BENCH_CLAUDE_EXECUTABLE=/home/mafzhang/.local/bin/claude
BENCH_CLAUDE_ARM=Claude
BENCH_CLAUDE_ALLOW_TOOLS=Read,Glob,Grep,Bash,Write,Edit,NotebookEdit,WebSearch,WebFetch

# Finch stays in its separate Python 3.12 environment; no Docker.
BENCH_FINCH_ROOT=/home/mafzhang/code/finch-baseline
BENCH_FINCH_PYTHON=/home/mafzhang/miniconda3/envs/finch-bench/bin/python
BENCH_FINCH_KERNEL_PYTHON=
BENCH_FINCH_COMMIT=aea66fdf2dd2be827727de50a73cae60dff59972
BENCH_FINCH_BWRAP=bwrap
BENCH_FINCH_ARM=Finch
BENCH_FINCH_MAX_STEPS=60
BENCH_FINCH_TEMPERATURE=1
# Upstream Finch default: 20 minutes for each full notebook replay.
BENCH_FINCH_EXECUTION_TIMEOUT=1200
BENCH_FINCH_MEMORY_MB=8192
BENCH_FINCH_CPUS=2
